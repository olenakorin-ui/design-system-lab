{
  "meta": {
    "tier": "theme",
    "figmaCollection": "2. Theme",
    "group": "shadow+blur"
  },
  "shadow": {
    "2xs": [
      {
        "$type": "shadow",
        "$value": {
          "offsetX": 0,
          "offsetY": 1,
          "blur": 0,
          "spread": 0,
          "color": "rgba(0,0,0,0.05)"
        }
      }
    ],
    "xs": [
      {
        "$type": "shadow",
        "$value": {
          "offsetX": 0,
          "offsetY": 1,
          "blur": 2,
          "spread": 0,
          "color": "rgba(0,0,0,0.05)"
        }
      }
    ],
    "sm": [
      {
        "$type": "shadow",
        "$value": {
          "offsetX": 0,
          "offsetY": 1,
          "blur": 3,
          "spread": 0,
          "color": "rgba(0,0,0,0.1)"
        }
      },
      {
        "$type": "shadow",
        "$value": {
          "offsetX": 0,
          "offsetY": 1,
          "blur": 2,
          "spread": -1,
          "color": "rgba(0,0,0,0.1)"
        }
      }
    ],
    "md": [
      {
        "$type": "shadow",
        "$value": {
          "offsetX": 0,
          "offsetY": 4,
          "blur": 6,
          "spread": -1,
          "color": "rgba(0,0,0,0.1)"
        }
      },
      {
        "$type": "shadow",
        "$value": {
          "offsetX": 0,
          "offsetY": 2,
          "blur": 4,
          "spread": -2,
          "color": "rgba(0,0,0,0.1)"
        }
      }
    ],
    "lg": [
      {
        "$type": "shadow",
        "$value": {
          "offsetX": 0,
          "offsetY": 10,
          "blur": 15,
          "spread": -3,
          "color": "rgba(0,0,0,0.1)"
        }
      },
      {
        "$type": "shadow",
        "$value": {
          "offsetX": 0,
          "offsetY": 4,
          "blur": 6,
          "spread": -4,
          "color": "rgba(0,0,0,0.1)"
        }
      }
    ],
    "xl": [
      {
        "$type": "shadow",
        "$value": {
          "offsetX": 0,
          "offsetY": 20,
          "blur": 25,
          "spread": -5,
          "color": "rgba(0,0,0,0.1)"
        }
      },
      {
        "$type": "shadow",
        "$value": {
          "offsetX": 0,
          "offsetY": 8,
          "blur": 10,
          "spread": -6,
          "color": "rgba(0,0,0,0.1)"
        }
      }
    ],
    "2xl": [
      {
        "$type": "shadow",
        "$value": {
          "offsetX": 0,
          "offsetY": 25,
          "blur": 50,
          "spread": -12,
          "color": "rgba(0,0,0,0.25)"
        }
      }
    ]
  },
  "blur": {
    "xs": {
      "$type": "dimension",
      "$value": "4px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "12px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "24px"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "40px"
    },
    "3xl": {
      "$type": "dimension",
      "$value": "64px"
    }
  }
}
